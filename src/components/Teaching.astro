---
import { teaching } from '../data/site';
---

<section class="section tone-sky" id="teaching" aria-labelledby="teaching-h">
  <div class="wrap">
    <p class="label" data-reveal>Speaking, training and facilitation</p>
    <h2 class="count" id="teaching-h" data-reveal>
      <span class="count__n">{teaching.figure}</span>
      <span class="count__t">{teaching.headline}</span>
    </h2>
    <p class="lede teach__lede" data-reveal>{teaching.lede}</p>

    {
      /* PHOTO SLOT: rendered only when teaching.photos has entries in src/data/site.ts */
      teaching.photos.length > 0 && (
        <ul class:list={['shots', { 'shots--single': teaching.photos.length === 1 }]} data-reveal>
          {teaching.photos.map((ph) => (
            <li>
              <figure>
                <img
                  src={ph.src}
                  srcset={ph.srcset}
                  sizes={teaching.photos.length === 1 ? '(max-width: 1200px) 92vw, 1120px' : '(max-width: 720px) 92vw, 540px'}
                  alt={ph.alt}
                  width={ph.width}
                  height={ph.height}
                  loading="lazy"
                  decoding="async"
                />
                {ph.caption && <figcaption>{ph.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      )
    }

    <div class="index">
      {
        teaching.groups.map((g) => (
          <div class="index__group" data-reveal>
            <h3 class="subhead">{g.title}</h3>
            <ul class="index__list">
              {g.sessions.map((s) => (
                <li class="session">
                  <h4 class="session__name">{s.name}</h4>
                  <p class="session__text">{s.text}</p>
                  <p class="session__where">{s.where}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="teach__note" data-reveal>{teaching.note}</p>
  </div>
</section>

<style>
  .count {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 clamp(16px, 2.4vw, 32px);
    margin-top: clamp(12px, 2vw, 24px);
  }
  .count__n {
    font-size: clamp(6.5rem, 27vw, 21rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.075em;
    margin-left: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--soft);
  }
  .count__t {
    font-size: var(--t-h2);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .teach__lede {
    margin-top: clamp(24px, 3.4vw, 44px);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px 16px;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .shots--single {
    grid-template-columns: minmax(0, 1fr);
  }
  .shots img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: clamp(16px, 2.4vw, 28px);
    background: var(--page);
  }
  .shots figcaption {
    margin-top: 12px;
    font-size: var(--t-small);
    color: var(--fg-2);
  }

  .index {
    margin-top: clamp(56px, 8vw, 112px);
    border-top: 1px solid var(--rule);
  }
  .index__group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 8px var(--gutter);
    padding-top: clamp(20px, 2.6vw, 28px);
    padding-bottom: clamp(28px, 4vw, 56px);
    border-bottom: 1px solid var(--rule);
  }
  .index__group .subhead {
    padding-top: 0.5em;
  }
  .session {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 4px var(--gutter);
    padding-block: 16px;
  }
  .session + .session {
    border-top: 1px solid var(--rule);
  }
  .session__name {
    grid-row: span 2;
    font-size: clamp(1.1875rem, 1.7vw, 1.375rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .session__text {
    text-wrap: pretty;
  }
  .session__where {
    font-size: var(--t-small);
    color: var(--fg-2);
  }
  .teach__note {
    margin-top: clamp(24px, 3vw, 36px);
    color: var(--fg-2);
  }

  @media (max-width: 820px) {
    .index__group,
    .session {
      grid-template-columns: minmax(0, 1fr);
    }
    .session__name {
      grid-row: auto;
    }
  }
</style>
