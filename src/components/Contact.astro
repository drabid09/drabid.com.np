---
import Icon from './Icon.astro';
import { contact, site } from '../data/site';
const year = new Date().getFullYear();
---

<section class="section tone-deep contact" id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <p class="label" data-reveal>Contact</p>
    <h2 class="h2 contact__h" id="contact-h" data-reveal>
      <span>{contact.headline[0]}</span>
      <span>{contact.headline[1]}</span>
      <span class="soft">{contact.lede}</span>
    </h2>

    <div class="contact__mail" data-reveal>
      <a class="contact__address" href={`mailto:${site.email}`}>{site.email}</a>
      <button class="contact__copy" type="button" data-copy={site.email}>
        <span data-copy-label>Copy address</span>
      </button>
    </div>

    <div class="contact__grid" data-reveal>
      <div>
        <h3 class="subhead">Open to</h3>
        <ul class="contact__open">
          {contact.openTo.map((o) => <li>{o}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="subhead">Elsewhere</h3>
        <ul class="contact__links">
          <li>
            <a class="arrow-link" data-external href={site.linkedin} rel="noopener me">LinkedIn <Icon name="up-right" /></a>
          </li>
          <li>
            <a class="arrow-link" data-external href={site.github} rel="noopener me">GitHub <Icon name="up-right" /></a>
          </li>
        </ul>
      </div>
    </div>

    <footer class="foot">
      <p>© {year} {site.name}</p>
      <p>{site.location}</p>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 0;
  }
  .contact__h {
    margin-top: clamp(16px, 2vw, 24px);
    max-width: none;
  }
  .contact__h span {
    display: block;
    text-wrap: balance;
  }
  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .contact__address {
    font-size: clamp(1.5rem, 4.6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.25s;
  }
  .contact__address:hover {
    text-decoration-color: var(--hl);
  }
  .contact__copy {
    padding: 9px 16px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-2);
    font-size: var(--t-small);
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .contact__copy:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }
  .contact__copy[data-copied] {
    color: var(--hl);
    border-color: var(--hl);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 36px var(--gutter);
    margin-top: clamp(56px, 8vw, 112px);
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--rule);
  }
  .contact__open,
  .contact__links {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }
  .contact__open {
    font-size: var(--t-lede);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(72px, 10vw, 144px);
    padding-block: 24px max(24px, env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--rule);
    font-size: var(--t-micro);
    color: var(--fg-2);
  }
  @media (max-width: 720px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
