---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href="#top">{site.name}</a>
    <nav class="nav__links" id="site-nav" aria-label="Sections">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav__tools">
      <button class="nav__btn" type="button" data-theme-toggle aria-label="Switch colour theme">
        <Icon name="theme" size={18} />
      </button>
      <button class="nav__btn nav__menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
        Menu
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--page) 76%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .nav[data-scrolled],
  .nav[data-open] {
    border-bottom-color: var(--line);
  }
  .nav[data-open] {
    background: var(--page);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-h);
  }
  .nav__brand {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links ul {
    display: flex;
    gap: clamp(16px, 2.4vw, 30px);
  }
  .nav__links a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__links a[aria-current='true'] {
    color: var(--accent-text);
  }
  .nav__tools {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav__btn {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .nav__btn:hover {
    color: var(--ink);
    background: var(--page-alt);
  }
  .nav__menu {
    display: none;
    padding: 0 12px;
  }

  @media (max-width: 820px) {
    .nav__menu {
      display: inline-grid;
    }
    .nav__links {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--page);
      border-bottom: 1px solid var(--line);
      padding: 8px max(var(--gutter), env(safe-area-inset-right, 0px)) 28px max(var(--gutter), env(safe-area-inset-left, 0px));
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0s 0.25s;
    }
    .nav[data-open] .nav__links {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
    .nav__links ul {
      flex-direction: column;
      gap: 0;
    }
    .nav__links a {
      display: block;
      padding: 12px 0;
      font-size: 1.75rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      color: var(--ink);
    }
  }
</style>
