---
import { research } from '../data/site';
---

<section class="section tone-page" id="research" aria-labelledby="research-h">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>AI research and adoption</p>
      <h2 class="h2" id="research-h" data-reveal>{research.headline}</h2>
      <p class="lede" data-reveal>{research.lede}</p>
    </div>

    <ul class="courses">
      {
        research.courses.map((c) => (
          <li class="course" data-reveal>
            <h3 class="course__word">{c.word}</h3>
            <div class="course__about">
              <p class="course__topic">{c.topic}</p>
              <p class="course__text">{c.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <dl class="totals" data-reveal>
      {
        research.totals.map((t) => (
          <div>
            <dt>{t.label}</dt>
            <dd>{t.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="block" data-reveal>
      <h3 class="subhead">{research.cycleTitle}</h3>
      <ol class="cycle">
        {
          research.cycle.map((step, i) => (
            <li>
              <span class="cycle__n">{i + 1}</span>
              <span class="cycle__w">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="block" data-reveal>
      <h3 class="subhead">{research.principlesTitle}</h3>
      <ul class="principles">
        {
          research.principles.map((p) => (
            <li>
              <h4>{p.title}</h4>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <blockquote class="premise" data-reveal>
      <p>{research.premise}</p>
    </blockquote>

    <div class="study" data-reveal>
      <p class="label">{research.study.label}</p>
      <h3 class="study__q">{research.study.question}</h3>
      <p class="study__text">{research.study.text}</p>
    </div>

    <div class="block frameworks" data-reveal>
      <h3 class="subhead">{research.frameworksTitle}</h3>
      <ul>
        {research.frameworks.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .courses {
    border-top: 1px solid var(--rule);
  }
  .course {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 8px var(--gutter);
    align-items: end;
    padding-block: clamp(20px, 3vw, 36px);
    border-bottom: 1px solid var(--rule);
  }
  .course__word {
    font-size: clamp(4rem, 15.5vw, 12.5rem);
    font-weight: 800;
    line-height: 0.84;
    letter-spacing: -0.065em;
    margin-left: -0.04em;
  }
  .course__about {
    padding-bottom: clamp(4px, 1vw, 14px);
  }
  .course__topic {
    font-size: var(--t-lede);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .course__text {
    margin-top: 6px;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .totals {
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(28px, 5vw, 72px);
    margin-top: clamp(24px, 3vw, 36px);
  }
  .totals div {
    display: flex;
    flex-direction: row-reverse;
    align-items: baseline;
    gap: 10px;
  }
  .totals dd {
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .totals dt {
    color: var(--fg-2);
  }

  .block {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 16px var(--gutter);
    margin-top: clamp(64px, 9vw, 128px);
  }
  .block .subhead {
    padding-top: 0.4em;
  }

  .cycle {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }
  .cycle li {
    display: grid;
    gap: 10px;
    padding: 16px 12px 0 0;
  }
  .cycle__n {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--hl);
  }
  .cycle__w {
    font-size: clamp(1.125rem, 1.9vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px) var(--gutter);
  }
  .principles h4 {
    font-size: var(--t-lede);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .principles p {
    margin-top: 8px;
    color: var(--fg-2);
    max-width: 30em;
    text-wrap: pretty;
  }

  .premise {
    margin-top: clamp(72px, 10vw, 144px);
  }
  .premise p {
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    max-width: 22em;
    text-wrap: balance;
  }

  /* The one tile on the page: it sets the research question apart from the teaching material around it. */
  .study {
    margin-top: clamp(72px, 10vw, 144px);
    padding: clamp(28px, 5vw, 72px);
    border-radius: clamp(20px, 3vw, 32px);
    background: var(--tile);
  }
  .study__q {
    margin-top: 14px;
    font-size: var(--t-h2);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .study__text {
    margin-top: clamp(18px, 2.4vw, 28px);
    max-width: 36em;
    color: var(--fg-2);
    font-size: var(--t-lede);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .frameworks ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    color: var(--fg-2);
  }
  .frameworks li:not(:last-child)::after {
    content: '/';
    margin-inline: 14px;
    color: var(--fg-3);
  }

  @media (max-width: 820px) {
    .course,
    .block {
      grid-template-columns: minmax(0, 1fr);
    }
    .cycle {
      grid-template-columns: minmax(0, 1fr);
      border-top: 0;
    }
    .cycle li {
      grid-template-columns: 2ch minmax(0, 1fr);
      align-items: baseline;
      gap: 14px;
      padding: 12px 0;
      border-top: 1px solid var(--rule);
    }
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
