---
import { credentials } from '../data/site';
const columns = [
  { title: 'Education', items: credentials.education },
  { title: 'Certifications', items: credentials.certifications },
];
---

<section class="section tone-page creds" id="credentials" aria-labelledby="credentials-h">
  <div class="wrap creds__grid">
    <h2 class="creds__h" id="credentials-h" data-reveal>{credentials.headline}</h2>
    <div class="creds__cols">
      {
        columns.map((col) => (
          <div data-reveal>
            <h3 class="subhead">{col.title}</h3>
            <ul class="creds__list">
              {col.items.map((item) => (
                <li>
                  <span class="creds__name">{item.name}</span>
                  <span class="creds__detail">{item.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .creds {
    padding-block: clamp(72px, 9vw, 128px);
  }
  .creds__grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 28px var(--gutter);
    align-items: start;
  }
  .creds__h {
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .creds__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px var(--gutter);
  }
  .creds__list {
    margin-top: 12px;
    border-top: 1px solid var(--rule);
  }
  .creds__list li {
    display: grid;
    gap: 2px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .creds__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .creds__detail {
    font-size: var(--t-small);
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 820px) {
    .creds__grid,
    .creds__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
