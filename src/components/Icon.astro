---
interface Props {
  name: 'right' | 'up-right' | 'plus' | 'theme' | 'check';
  size?: number;
}
const { name, size = 16 } = Astro.props;
const paths: Record<Props['name'], string> = {
  right: 'M3 8h10M9 4l4 4-4 4',
  'up-right': 'M5 11l6-6M6 5h5v5',
  plus: 'M8 3v10M3 8h10',
  theme: 'M8 1.75a6.25 6.25 0 1 0 0 12.5a6.25 6.25 0 0 0 0-12.5zM8 1.75v12.5',
  check: 'M3.5 8.5l3 3 6-7',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg
>
