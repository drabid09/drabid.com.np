---
import Icon from './Icon.astro';
import { projects } from '../data/site';
---

<section class="section tone-band" id="projects" aria-labelledby="projects-h">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>Selected projects</p>
      <h2 class="h2 projects__h" id="projects-h" data-reveal>
        <span>{projects.headline[0]}</span>
        <span class="soft">{projects.headline[1]}</span>
      </h2>
      <p class="lede" data-reveal>{projects.lede}</p>
    </div>

    {
      projects.items.map((p) => (
        <article class="project">
          {
            /* PHOTO SLOT: rendered only when the project has an image in src/data/site.ts */
            p.image && (
              <figure class="project__shot" data-reveal>
                <img src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="lazy" decoding="async" />
              </figure>
            )
          }
          <header class="project__head" data-reveal>
            <p class="project__status">{p.status}</p>
            <h3 class="project__name">{p.name}</h3>
            <p class="project__line">{p.line}</p>
          </header>

          <ol class="flow" aria-label="How it works, in order" data-reveal>
            {
              p.flow.map((step, i) => (
                <li>
                  {i > 0 && <Icon name="right" size={14} />}
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>

          <div class="project__cols" data-reveal>
            <div>
              <h4>The problem</h4>
              <p>{p.problem}</p>
            </div>
            <div>
              <h4>What I built</h4>
              <p>{p.built}</p>
            </div>
            <div>
              <h4>Where it stands</h4>
              <p>{p.stands}</p>
            </div>
          </div>

          <div class="project__foot" data-reveal>
            <details class="more">
              <summary>
                <span class="more__icon"><Icon name="plus" size={14} /></span>
                Features and stack
              </summary>
              <div class="more__body">
                <div>
                  <h4>Features</h4>
                  <ul class="more__list">{p.features.map((f) => <li>{f}</li>)}</ul>
                </div>
                <div>
                  <h4>Stack</h4>
                  <ul class="more__stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
                </div>
              </div>
            </details>
            {
              p.links.length > 0 && (
                <p class="project__links">
                  {p.links.map((l) => (
                    <a class="arrow-link" data-external href={l.href} rel="noopener">
                      {l.label} <Icon name="up-right" />
                    </a>
                  ))}
                </p>
              )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects__h {
    max-width: 20ch !important;
  }
  .projects__h span {
    display: block;
  }
  .project {
    padding-top: clamp(40px, 6vw, 80px);
    border-top: 1px solid var(--rule);
  }
  .project + .project {
    margin-top: clamp(72px, 10vw, 144px);
  }
  .project__shot {
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .project__shot img {
    width: 100%;
    border-radius: 20px;
  }
  .project__status {
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--hl);
  }
  .project__name {
    margin-top: 12px;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .project__line {
    margin-top: clamp(14px, 2vw, 22px);
    font-size: var(--t-lede);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--fg-2);
    max-width: 30em;
    text-wrap: balance;
  }

  .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin-top: clamp(28px, 4vw, 48px);
    padding-block: 18px;
    border-block: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: var(--t-small);
  }
  .flow li {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .flow svg {
    color: var(--spark);
    flex: none;
  }

  .project__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px var(--gutter);
    margin-top: clamp(28px, 4vw, 48px);
  }
  .project__cols h4,
  .more__body h4 {
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--fg-2);
    margin-bottom: 10px;
  }
  .project__cols p {
    text-wrap: pretty;
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px var(--gutter);
    margin-top: clamp(28px, 4vw, 44px);
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding-top: 2px;
  }

  .more {
    flex: 1 1 320px;
    min-width: 0;
  }
  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more__icon {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--fg-2);
    transition: transform 0.35s var(--ease), color 0.2s, border-color 0.2s;
  }
  .more summary:hover .more__icon {
    color: var(--fg);
    border-color: var(--fg-3);
  }
  .more[open] .more__icon {
    transform: rotate(45deg);
  }
  .more__body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 28px var(--gutter);
    padding-top: 24px;
  }
  .more__list {
    display: grid;
    gap: 8px;
  }
  .more__list li {
    position: relative;
    padding-left: 24px;
  }
  .more__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 12px;
    height: 1px;
    background: var(--fg-3);
  }
  .more__stack {
    display: grid;
    gap: 6px;
    font-family: var(--mono);
    font-size: var(--t-small);
    color: var(--fg-2);
  }

  @media (max-width: 820px) {
    .project__cols,
    .more__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
