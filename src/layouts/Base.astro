---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: site.portrait ? new URL(site.portrait.src, site.url).href : ogImage,
  jobTitle: 'AI Education and Adoption Specialist',
  description: site.description,
  worksFor: { '@type': 'Organization', name: 'NAAMII', url: 'https://www.naamii.org.np' },
  address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Islington College' },
    { '@type': 'CollegeOrUniversity', name: 'Nepal College of Information Technology' },
  ],
  knowsAbout: [
    'AI literacy',
    'AI adoption',
    'Responsible AI',
    'AI governance',
    'Cybersecurity',
    'Governance, risk and compliance',
    'ISO/IEC 42001',
    'Training and facilitation',
  ],
  knowsLanguage: ['en', 'ne'],
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Drabid Subedi: I teach people to work with AI, and institutions to trust it." />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1e2b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- Applies a saved theme before first paint, so the page never flashes the wrong one. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* Theme switch */
        var themeBtn = document.querySelector('[data-theme-toggle]');
        function currentTheme() {
          var t = root.getAttribute('data-theme');
          if (t === 'light' || t === 'dark') return t;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function labelTheme() {
          if (themeBtn) themeBtn.setAttribute('aria-label', 'Switch to ' + (currentTheme() === 'dark' ? 'light' : 'dark') + ' theme');
        }
        if (themeBtn) {
          labelTheme();
          themeBtn.addEventListener('click', function () {
            var next = currentTheme() === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch (e) {}
            labelTheme();
          });
        }

        /* Mobile menu */
        var nav = document.querySelector('[data-nav]');
        var menuBtn = document.querySelector('[data-menu-toggle]');
        function setMenu(open) {
          nav.toggleAttribute('data-open', open);
          menuBtn.setAttribute('aria-expanded', String(open));
          menuBtn.textContent = open ? 'Close' : 'Menu';
        }
        if (nav && menuBtn) {
          menuBtn.addEventListener('click', function () {
            setMenu(!nav.hasAttribute('data-open'));
          });
          nav.addEventListener('click', function (e) {
            if (e.target.closest && e.target.closest('a')) setMenu(false);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
              setMenu(false);
              menuBtn.focus();
            }
          });
          var onScroll = function () {
            nav.toggleAttribute('data-scrolled', window.scrollY > 8);
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        /* Copy email */
        var copyBtn = document.querySelector('[data-copy]');
        if (copyBtn) {
          var copyLabel = copyBtn.querySelector('[data-copy-label]');
          copyBtn.addEventListener('click', function () {
            var value = copyBtn.getAttribute('data-copy');
            var done = function (ok) {
              copyLabel.textContent = ok ? 'Copied' : 'Press and hold the address to copy';
              copyBtn.toggleAttribute('data-copied', ok);
              setTimeout(function () {
                copyLabel.textContent = 'Copy address';
                copyBtn.removeAttribute('data-copied');
              }, 2400);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(value).then(
                function () {
                  done(true);
                },
                function () {
                  done(false);
                }
              );
            } else {
              done(false);
            }
          });
        }

        if (!('IntersectionObserver' in window)) return;

        /* Highlight the section being read in the nav */
        var links = {};
        [].forEach.call(document.querySelectorAll('.nav__links a[href^="#"]'), function (a) {
          links[a.getAttribute('href').slice(1)] = a;
        });
        var spy = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              var link = links[en.target.id];
              if (!link) return;
              if (en.isIntersecting) {
                for (var k in links) links[k].removeAttribute('aria-current');
                link.setAttribute('aria-current', 'true');
              }
            });
          },
          { rootMargin: '-45% 0px -50% 0px' }
        );
        for (var id in links) {
          var sec = document.getElementById(id);
          if (sec) spy.observe(sec);
        }

        /* Entrance on scroll. Anything already on screen is left alone, so the first view is complete at rest. */
        if (reduce) return;
        var els = [].slice.call(document.querySelectorAll('[data-reveal]'));
        var vh = window.innerHeight;
        els.forEach(function (el) {
          if (el.getBoundingClientRect().top < vh) el.classList.add('is-in');
        });
        root.classList.add('reveal-on');
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('is-in');
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.01 }
        );
        els.forEach(function (el) {
          if (!el.classList.contains('is-in')) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
